<Window x:Class="AdminApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel" Width="780" Height="460"
        MinWidth="740" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- Server -->
      <RowDefinition Height="Auto"/>  <!-- Running Text -->
      <RowDefinition Height="Auto"/>  <!-- Video -->
      <RowDefinition Height="*"/>     <!-- Spacer -->
      <RowDefinition Height="Auto"/>  <!-- Bottom actions -->
      <RowDefinition Height="Auto"/>  <!-- Status bar -->
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Server -->
    <TextBlock Grid.Row="0" Grid.Column="0" Text="Server URL" VerticalAlignment="Center" Margin="0,0,12,8"/>
    <TextBox  x:Name="ServerUrlBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,12,8"/>
    <Button   Grid.Row="0" Grid.Column="3" Content="Sambungkan" Padding="14,6" Margin="0,0,0,8" Click="ConnectAndSave_Click"/>

    <!-- Running Text -->
    <TextBlock Grid.Row="1" Grid.Column="0" Text="Running Text" VerticalAlignment="Center" Margin="0,0,12,8"/>
    <TextBox  x:Name="RunningTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8"/>

    <!-- Video -->
    <TextBlock Grid.Row="2" Grid.Column="0" Text="Video" VerticalAlignment="Center" Margin="0,0,12,8"/>
    <TextBox  x:Name="VideoPathBox" Grid.Row="2" Grid.Column="1" Margin="0,0,12,8" IsReadOnly="True" ToolTip="URL / path video"/>
    <Button   Grid.Row="2" Grid.Column="2" Content="Pilih..." Padding="12,6" Margin="0,0,8,8" Click="Browse_Click"/>
    <Button   Grid.Row="2" Grid.Column="3" Content="Upload ke Server" Padding="12,6" Margin="0,0,0,8" Click="Upload_Click"/>

    <!-- Bottom actions -->
    <CheckBox x:Name="ShowVideoCheck" Grid.Row="4" Grid.Column="0" Content="Tampilkan video" VerticalAlignment="Center"/>
    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0,0,0">
      <Button Content="Simpan Semua"   Padding="14,6" Click="SaveSettings_Click"/>
    </StackPanel>
    <Button Grid.Row="4" Grid.Column="3" Content="Reset Nomor" Padding="14,6" HorizontalAlignment="Right" Click="Reset_Click"/>

    <!-- Status -->
    <StatusBar Grid.Row="5" Grid.ColumnSpan="4" Margin="0,8,0,0">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Siap"/>
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>